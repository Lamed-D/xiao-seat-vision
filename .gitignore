firmware/**/build/
firmware/xiao_seat_vision/*.bin
firmware/xiao_seat_vision/*.elf
firmware/xiao_seat_vision/*.map
*.o

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
bridge/data/

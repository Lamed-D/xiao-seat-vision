# xiao-seat-vision — root environment (copy to .env; never commit .env)
# Read by `docker compose` (compose.yaml). Service-specific settings live in
# bridge/.env and video_feeder/.env.

# ---- Mosquitto ----
# Host address the TLS port binds to. Use your PC's LAN IP to avoid exposing it on
# other interfaces, e.g. 192.168.0.10. Never port-forward 8883 to the internet.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_TLS_PORT=8883
# Password of the "healthcheck" MQTT user (sh mqtt/scripts/add-user.sh healthcheck <pw>)
MQTT_HEALTHCHECK_PASSWORD=change-me

# ---- Dashboard (http://127.0.0.1:8080) ----
DASHBOARD_PORT=8080
# https://<project-ref>.supabase.co/functions/v1/dashboard-api
DASHBOARD_API_URL=

# ---- Video feeder (profile test-video, http://127.0.0.1:8090) ----
FEEDER_PORT=8090

# ---- Supabase CLI (used by scripts/deploy steps, not by containers) ----
# Access token (starts with sbp_):
#   https://supabase.com/dashboard/account/tokens -> "Generate new token" -> copy (shown only once)
SUPABASE_ACCESS_TOKEN=
# Database password chosen when the project was created. Forgot it?
#   Project Settings -> Database -> "Reset database password"
#   (https://supabase.com/dashboard/project/<project-ref>/settings/database)
SUPABASE_DB_PASSWORD=
# Project reference id = the part before .supabase.co in the project URL
#   (Project Settings -> General -> Reference ID)
SUPABASE_PROJECT_REF=

# ---- Edge Impulse (model training) ----
# API key (starts with ei_):
#   https://studio.edgeimpulse.com -> open your project -> Dashboard -> "Keys" tab -> API key
#   (none listed? "Add new API key", role Admin)
EI_API_KEY=

# ---- Supabase Edge Function secrets (NOT read by compose; reference only) ----
# Set them with:  supabase secrets set --env-file supabase/.env.secrets
#   BRIDGE_API_TOKENS        comma-separated, >= 32 chars (same value as bridge/.env BRIDGE_API_TOKEN)
#   DASHBOARD_VIEWER_TOKENS  comma-separated, >= 32 chars
#   DASHBOARD_ADMIN_TOKENS   comma-separated, >= 32 chars (developer-mode data, layout editing)
#   DASHBOARD_ALLOWED_ORIGINS e.g. http://localhost:8080,http://127.0.0.1:8080
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically —
# never put the service role key in any file in this repo.

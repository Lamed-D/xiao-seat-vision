# xiao-seat-vision video feeder (copy to video_feeder/.env; never commit .env)
# Videos are read from ./test-videos (mounted read-only at /videos).

VIDEO_FILE=demo.mp4
FEED_FPS=3
FEED_WIDTH=320
FEED_HEIGHT=240
FEED_LOOP=true
AUTOPLAY=false
LOG_LEVEL=INFO

# TARGET=esp32 -> send frames to the real board (on-device Edge Impulse inference)
# TARGET=mqtt  -> no board: publish labelled test events + snapshots via MQTT
TARGET=esp32

# --- TARGET=esp32 ---
ESP32_URL=http://192.168.0.42
ESP32_WEB_TOKEN=same-as-XSV_WEB_TOKEN-in-config.h

# --- TARGET=mqtt ---
# Ground-truth labels (CSV: start_s,end_s,seat_id,state). Default: <video>.labels.csv
# LABELS_FILE=/videos/demo.labels.csv
TEST_DEVICE_ID=xiao-test-01
TEST_DEVICE_PASSWORD=change-me
MQTT_TLS=true
MQTT_TOPIC_PREFIX=xiao-seat-vision
TEST_SNAPSHOT_INTERVAL_S=30

# Edge Function secrets (copy to supabase/.env.secrets — git-ignored — then:
#   supabase secrets set --env-file supabase/.env.secrets --project-ref <ref>)
# Generate each token with:  openssl rand -hex 32
BRIDGE_API_TOKENS=
DASHBOARD_VIEWER_TOKENS=
DASHBOARD_ADMIN_TOKENS=
DASHBOARD_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

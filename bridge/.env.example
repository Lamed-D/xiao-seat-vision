# xiao-seat-vision bridge configuration (copy to bridge/.env; never commit .env)
#
# In Docker Compose the broker is reached by its service name on the internal
# network (MQTT_HOST=mosquitto). The ESP32 must NOT use "mosquitto"/"localhost";
# it uses the PC's LAN IP / hostname (see mqtt/README.md).

MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TLS=true
# CA that signed the broker certificate (path inside the container)
MQTT_CA_CERT=/certs/ca.crt
MQTT_USERNAME=xiao-seat-vision-bridge
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=xiao-seat-vision-bridge
MQTT_TOPIC_PREFIX=xiao-seat-vision

# https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1
# Must also be in the Supabase secret BRIDGE_API_TOKENS (>= 32 chars, random)
BRIDGE_API_TOKEN=generate-with-openssl-rand-hex-32

HTTP_TIMEOUT_S=10
DEAD_LETTER_PATH=/app/data/dead_letter.jsonl
LOG_LEVEL=INFO
